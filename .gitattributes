* text=auto

# PowerShell scripts must reach Windows with CRLF and keep their byte-order mark. Windows
# PowerShell 5.1 reads a BOM-less .ps1 as Windows-1252, so a stray UTF-8 byte decodes into a smart
# quote and breaks parsing many lines later, with an error that points nowhere near the cause.
*.ps1 text eol=crlf working-tree-encoding=UTF-8

*.sh text eol=lf
*.cs text
*.json text
*.md text

# Binary
*.brhr binary
*.png binary
*.jpg binary
